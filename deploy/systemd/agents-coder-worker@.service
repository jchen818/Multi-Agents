# Coder worker (Phase 6): consumes agents:coder:in, prepares gpu-validation changes, never pushes.
# Installed by deploy/systemd/install.sh; runs as the agents' Unix user from the repo checkout.
[Unit]
Description=Multi-Agents coder worker %i
After=network-online.target docker.service
Wants=network-online.target
# Redis runs in Docker (deploy/redis, restart: unless-stopped); the worker retries until it is reachable.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
# agents.env is a shell file (set -a; source), so load it through bash rather than EnvironmentFile=
ExecStart=/bin/bash -c 'set -a; source ./agents.env; set +a; exec ./.venv/bin/python -m agents.coder.worker'
Restart=on-failure
RestartSec=15
# SIGTERM lets the current message finish; after this the process is killed and the message is redelivered.
KillSignal=SIGTERM
TimeoutStopSec=600
Environment=PYTHONUNBUFFERED=1

# Hardening: no privilege gain, private /tmp, OS directories read-only. It needs the repo, the network
# (vLLM, Redis, GitHub fetch), Docker for the pytest sandbox and its own home for model/tool caches.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=8G

[Install]
WantedBy=multi-user.target
