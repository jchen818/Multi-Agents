#!/usr/bin/env bash
# Pre-push check. Install once:  ln -sf ../../scripts/pre-push .git/hooks/pre-push
# Fast on purpose: git keeps the GitHub connection open while this runs and GitHub drops it after a few minutes.
# If the push brings in agent or planner changes, the pushed commit must carry a stamp from scripts/gate.
# Otherwise (docs, configs outside those paths) it runs the unit tests only.
source "$(dirname "$(readlink -f "$0")")/gate-common.sh"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue      # deleting a branch
  if [ -f "$STAMPS/$local_sha" ]; then
    echo "pre-push: $(git rev-parse --short "$local_sha") passed scripts/gate - ok"
    continue
  fi
  if [ "$(git rev-parse HEAD)" = "$local_sha" ] && needs_evals; then
    echo "pre-push: this push changes agents/tools/evals but $(git rev-parse --short "$local_sha") has no gate stamp."
    echo "pre-push: run  scripts/gate  (about 6 min), then push again - push blocked"
    exit 1
  fi
  .venv/bin/python -m pytest -q tests/ >/tmp/prepush-pytest.log 2>&1 \
    || { echo "pre-push: unit tests failed (see /tmp/prepush-pytest.log) - push blocked"; exit 1; }
  echo "pre-push: unit tests ok (no agent changes, evals not needed)"
done
exit 0
